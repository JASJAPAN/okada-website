<form class="contact-form js-contact-form" name="contact" method="POST" action="/thanks/" data-netlify="true" data-netlify-honeypot="bot-field" novalidate>
  <input type="hidden" name="form-name" value="contact">
  <input type="hidden" name="subject" data-remove-prefix value="【株式会社オカダ】ホームページからお問い合わせ">
  <p class="bot-field" aria-hidden="true"><label>この欄は入力しないでください<input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
  <div class="field-row">
    <label>お名前<span>必須</span><input name="name" type="text" autocomplete="name" required></label>
    <label>会社名・店舗名<input name="company" type="text" autocomplete="organization"></label>
  </div>
  <div class="field-row">
    <label>メールアドレス<span>必須</span><input name="email" type="email" autocomplete="email" inputmode="email" required></label>
    <label>電話番号<input name="phone" type="tel" autocomplete="tel" inputmode="tel"></label>
  </div>
  <div class="field-row">
    <label>ご相談内容<span>必須</span><select name="category" required><option value="">選択してください</option><option>飲食店トータルコンサルティング</option><option>業務用厨房機器・厨房設計</option><option>店舗設計・内装工事</option><option>新規開業・業態開発</option><option>商品・メニュー開発</option><option>集客・マーケティング</option><option>DX・システム</option><option>その他</option></select></label>
    <label>ご相談エリア<select name="area"><option>熊本市</option><option>熊本県内</option><option>九州エリア</option><option>その他</option></select></label>
  </div>
  <label class="full-field">お問い合わせ内容<span>必須</span><textarea name="message" rows="7" placeholder="現在の状況や、お困りごとをご自由にお書きください。" required></textarea></label>
  <label class="consent"><input type="checkbox" name="privacy_agree" value="同意する" required><span><a href="/privacy/" target="_blank" rel="noopener">プライバシーポリシー</a>に同意して送信する</span></label>
  <div class="form-actions"><button class="button submit" type="submit">相談内容を送信する <span>→</span></button><p>通常、内容を確認後に担当者からご連絡します。</p></div>
  <div class="form-status" role="status" aria-live="polite"></div>
</form>
