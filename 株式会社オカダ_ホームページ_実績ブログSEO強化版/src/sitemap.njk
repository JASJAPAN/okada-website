---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc></url>
  <url><loc>{{ site.url }}/services/kitchen-equipment-kumamoto/</loc></url>
  <url><loc>{{ site.url }}/services/restaurant-interior-kumamoto/</loc></url>
  <url><loc>{{ site.url }}/services/restaurant-consulting-kumamoto/</loc></url>
  <url><loc>{{ site.url }}/works/</loc></url>
  <url><loc>{{ site.url }}/blog/</loc></url>
  <url><loc>{{ site.url }}/contact/</loc></url>
  <url><loc>{{ site.url }}/company/</loc></url>
  {% for work in collections.works %}<url><loc>{{ site.url }}{{ work.url }}</loc><lastmod>{{ work.date | dateISO }}</lastmod></url>{% endfor %}
  {% for post in collections.blog %}<url><loc>{{ site.url }}{{ post.url }}</loc><lastmod>{{ post.date | dateISO }}</lastmod></url>{% endfor %}
</urlset>
